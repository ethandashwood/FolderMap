<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:FolderMap.Controls"
        x:Class="FolderMap.Views.MainWindow"
        Title="FolderMap"
        Width="1320" Height="860" MinWidth="900" MinHeight="600">

  <Window.Styles>
    <!-- Keep tree expansion in sync with FolderNode.IsExpanded -->
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- ===== Top bar: choose and scan a folder ===== -->
    <Border DockPanel.Dock="Top" Padding="12,10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <TextBlock Text="Folder" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
        <TextBox Grid.Column="1" Text="{Binding ScanPath, Mode=TwoWay}"
                 Watermark="e.g. C:\ or C:\Users\Ethan" IsEnabled="{Binding IsIdle}" />
        <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0"
                Click="OnBrowseClick" IsEnabled="{Binding IsIdle}" />
        <Button Grid.Column="3" Content="Scan" Margin="8,0,0,0" Classes="accent" MinWidth="80"
                Command="{Binding ScanCommand}" IsEnabled="{Binding IsIdle}" />
        <Button Grid.Column="4" Content="Cancel" Margin="8,0,0,0"
                Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
      </Grid>
    </Border>

    <!-- ===== Bottom: status bar ===== -->
    <Border DockPanel.Dock="Bottom" Padding="12,6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                     Width="140" Margin="10,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- ===== Bottom: actions for the selected file/folder ===== -->
    <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="#40808080">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="Selected" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="{Binding SelectedText}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0"
                    IsEnabled="{Binding CanActOnSelection}">
          <Button Content="Open" Click="OnOpenClick" />
          <Button Content="Show in Explorer" Click="OnRevealClick" />
          <Button Content="Show in tree" Click="OnGoToClick" />
          <Button Content="Rename…" Click="OnRenameClick" />
          <Button Content="Move to…" Click="OnMoveClick" />
          <Button Content="Recycle" Click="OnRecycleClick" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Padding="0">

      <!-- ================= Explorer ================= -->
      <TabItem Header="Explorer">
        <Grid ColumnDefinitions="340,5,*">

          <TreeView x:Name="FolderTree" ItemsSource="{Binding RootItems}"
                    SelectionChanged="OnTreeSelectionChanged">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Folders}">
                <Grid ColumnDefinitions="Auto,Auto,Auto" ToolTip.Tip="{Binding FullPath}">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="200"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="8,0" Opacity="0.7"
                             FontSize="12" VerticalAlignment="Center" />
                  <ProgressBar Grid.Column="2" Value="{Binding PercentOfParent}" Maximum="100"
                               Width="44" MinWidth="44" Height="5" MinHeight="5" VerticalAlignment="Center" />
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

          <Grid Grid.Column="2" RowDefinitions="Auto,*,5,260">

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,8">
              <Button Content="Up a level" Command="{Binding GoUpCommand}" />
              <TextBlock Grid.Column="1" Text="{Binding CurrentPathText}" FontWeight="SemiBold"
                         VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Scroll to zoom · drag to pan · double-click opens · right-click goes up" Opacity="0.6"
                           FontSize="12" VerticalAlignment="Center" />
                <ComboBox SelectedIndex="{Binding ChartMode, Mode=TwoWay}" Width="130">
                  <ComboBoxItem Content="Treemap" />
                  <ComboBoxItem Content="Sunburst" />
                </ComboBox>
              </StackPanel>
            </Grid>

            <Panel Grid.Row="1" Margin="10,0,10,6">
              <c:TreemapControl Root="{Binding CurrentFolder, Mode=TwoWay}"
                                SelectedNode="{Binding SelectedEntry, Mode=TwoWay}"
                                Version="{Binding ChartVersion}"
                                IsVisible="{Binding IsTreemap}" />
              <c:SunburstControl Root="{Binding CurrentFolder, Mode=TwoWay}"
                                 SelectedNode="{Binding SelectedEntry, Mode=TwoWay}"
                                 Version="{Binding ChartVersion}"
                                 IsVisible="{Binding IsSunburst}" />
            </Panel>

            <GridSplitter Grid.Row="2" ResizeDirection="Rows" />

            <DataGrid Grid.Row="3" ItemsSource="{Binding CurrentItems}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                      CanUserResizeColumns="True" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      SelectionChanged="OnGridSelectionChanged" DoubleTapped="OnGridDoubleTapped">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" />
                <DataGridTemplateColumn Header="% of folder" SortMemberPath="Size" Width="150">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,52" Margin="8,0">
                        <ProgressBar Value="{Binding PercentOfParent}" Maximum="100" MinWidth="40"
                                     VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Files" Binding="{Binding FilesText}" SortMemberPath="Size" Width="90" />
                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="140" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ================= Search ================= -->
      <TabItem Header="Search">
        <DockPanel Margin="12">
          <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <StackPanel Margin="0,0,14,10">
              <TextBlock Classes="label" Text="Name contains (or use * and ?)" />
              <TextBox Text="{Binding SearchText, Mode=TwoWay}" Width="260" Watermark="e.g. invoice   or   IMG_2024*"
                       KeyDown="OnSearchKeyDown" />
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Classes="label" Text="Extensions" />
              <TextBox Text="{Binding SearchExtensions, Mode=TwoWay}" Width="170" Watermark="e.g. jpg, png, mp4"
                       KeyDown="OnSearchKeyDown" />
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Classes="label" Text="At least (MB)" />
              <NumericUpDown Value="{Binding MinSizeMb, Mode=TwoWay}" Minimum="0" Increment="10"
                             FormatString="0.##" Width="150" />
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
              <TextBlock Classes="label" Text="Modified in the last N days" />
              <NumericUpDown Value="{Binding ModifiedWithinDays, Mode=TwoWay}" Minimum="0" Increment="7"
                             FormatString="0" Width="150" />
            </StackPanel>
            <CheckBox Content="Include folders" IsChecked="{Binding IncludeFolders, Mode=TwoWay}"
                      VerticalAlignment="Bottom" Margin="0,0,14,10" />
            <Button Content="Search" Classes="accent" MinWidth="90" VerticalAlignment="Bottom" Margin="0,0,0,10"
                    Command="{Binding SearchCommand}" />
          </WrapPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding SearchSummary}" Margin="0,0,0,8" Opacity="0.8" />
          <DataGrid ItemsSource="{Binding SearchResults}"
                    IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                    SelectionMode="Single" GridLinesVisibility="Horizontal"
                    SelectionChanged="OnGridSelectionChanged" DoubleTapped="OnGridDoubleTapped">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90" />
              <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" />
              <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="140" />
              <DataGridTextColumn Header="Folder" Binding="{Binding ParentPath}" Width="3*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ================= Large files ================= -->
      <TabItem Header="Largest files">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Opacity="0.8"
                     Text="The 1,000 biggest files in the scanned folder. Double-click one to jump to it in the Explorer tab." />
          <DataGrid ItemsSource="{Binding LargeFiles}"
                    IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                    SelectionMode="Single" GridLinesVisibility="Horizontal"
                    SelectionChanged="OnGridSelectionChanged" DoubleTapped="OnGridDoubleTapped">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90" />
              <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" />
              <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="140" />
              <DataGridTextColumn Header="Folder" Binding="{Binding ParentPath}" Width="3*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ================= File types ================= -->
      <TabItem Header="File types">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Opacity="0.8"
                     Text="How much space each kind of file uses. Tip: search an extension in the Search tab to see every file of that type." />
          <DataGrid ItemsSource="{Binding FileTypes}"
                    IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                    SelectionMode="Single" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="140" />
              <DataGridTextColumn Header="Files" Binding="{Binding CountText}" SortMemberPath="Count" Width="110" />
              <DataGridTextColumn Header="Total size" Binding="{Binding SizeText}" SortMemberPath="TotalSize" Width="120" />
              <DataGridTemplateColumn Header="Share of total" SortMemberPath="TotalSize" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,60" Margin="8,0">
                      <ProgressBar Value="{Binding Percent}" Maximum="100" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="12"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ================= Duplicates ================= -->
      <TabItem Header="Duplicates">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Classes="label" Text="Ignore files smaller than (MB)" />
              <NumericUpDown Value="{Binding DuplicateMinMb, Mode=TwoWay}" Minimum="0" Increment="1"
                             FormatString="0.##" Width="170" />
            </StackPanel>
            <Button Content="Find duplicates" Classes="accent" VerticalAlignment="Bottom"
                    Command="{Binding FindDuplicatesCommand}" IsEnabled="{Binding IsIdle}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding DuplicateSummary}" Margin="0,0,0,8" Opacity="0.8"
                     TextWrapping="Wrap" />
          <DataGrid ItemsSource="{Binding Duplicates}"
                    IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                    SelectionMode="Single" GridLinesVisibility="Horizontal"
                    SelectionChanged="OnGridSelectionChanged" DoubleTapped="OnGridDoubleTapped">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Set" Binding="{Binding Group}" Width="60" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" />
              <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="140" />
              <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
